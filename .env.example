# GitHub API Configuration
# Optional for public repos (subject to 60 req/hr rate limit), recommended for 5,000 req/hr limit
GITHUB_TOKEN=

# LLM Provider Configuration
# Supported providers: gemini, openai, anthropic, mock
DEFAULT_LLM_PROVIDER=gemini

# Provider API Keys (specify the one matching your DEFAULT_LLM_PROVIDER)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent Execution Defaults
DEFAULT_MAX_ISSUES=30
DEFAULT_DRY_RUN=true
LOG_LEVEL=INFO
